PORT=1234
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# bujirun-backend의 jwt.secret과 반드시 동일해야 함
JWT_SECRET=

# bujirun-backend REST API 주소 (일정 접근 권한 확인 + room flush 대상)
SPRING_API_BASE_URL=http://spring-boot:8080

# bujirun-backend의 internal.api.secret(INTERNAL_API_SECRET)과 반드시 동일해야 함.
# room의 flush(PUT /api/internal/itineraries/**)를 호출할 때 X-Internal-Secret 헤더로 실어보냄.
INTERNAL_API_SECRET=
